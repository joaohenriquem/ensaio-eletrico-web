    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.2",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/selenium-webdriver": "^4.35.6",
    "@vitejs/plugin-react": "^4.3.4",
    "chai": "^6.2.2",
    "chromedriver": "^149.0.0",
    "cross-env": "^10.1.0",
